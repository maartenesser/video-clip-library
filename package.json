{
  "name": "video-clip-library",
  "version": "0.1.0",
  "private": true,
  "description": "Video clip library for social media ads - transforms long videos into tagged short clips",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm -r test",
    "test:database": "pnpm --filter @video-clip-library/database test",
    "test:storage": "pnpm --filter @video-clip-library/storage test",
    "test:api": "pnpm --filter web test:api",
    "test:ui": "pnpm --filter web test:ui",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:workers": "cd workers/cloudflare && pytest",
    "lint": "pnpm -r lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "next": "15.5.28",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser@>=5.0.0 <5.5.6": "^5.5.6",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.18": "^8.5.18",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "flatted@<3.4.2": "^3.4.2",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "browserslist@<4.28.7": "^4.28.7",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6"
    }
  }
}
